# Subscription authentication. Generate with:  claude setup-token
# This is the ONLY supported credential. Never commit the real .env.
CLAUDE_CODE_OAUTH_TOKEN=

# Discord incoming webhook URLs, one per channel key in config.yaml.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_OPS=

# Set to "fake" to run the pipeline without consuming any subscription quota.
# Leave unset (or set to anything else) to run real agents on the subscription.
RUNNER=

# Opt-in to API billing instead of the subscription. Leave unset.
ALLOW_API_BILLING=

# Real two-way Discord bot (Plan B): create an Application + Bot at
# https://discord.com/developers/applications, enable the "Message Content"
# privileged intent under Bot settings, and invite it to your server with
# the `bot` scope. Paste the bot token here (never the webhook URL above).
DISCORD_BOT_TOKEN=

# The ONE Discord user ID authorized to approve/deny/answer a parked run and
# to run the bot's admin commands (!stop, !disable, !budget, ...). Messages
# from anyone else are ignored without a reply. Get it with Developer Mode on
# (User Settings -> Advanced -> Developer Mode), then right-click your own
# name -> Copy User ID.
DISCORD_OWNER_ID=

# Numeric Discord channel ID (not the webhook URL) that the bot posts
# approvals/questions/admin replies into, referenced by config.yaml's
# discord.botChannels.ops.
DISCORD_CHANNEL_ID_OPS=

# Infrastructure token ("clanker-infra"): a fine-grained PAT owned by
# Clanker-HQ, all repositories, with every permission EXCEPT Administration,
# which is set to No access.
#
# Administration is withheld for one specific reason: it is what would let the
# system disable the `protect-main` ruleset on clanker-automated-system, and
# that ruleset is the last mechanical bound stopping a direct push to the
# default branch that bypasses mergePR's gates entirely. Everything else is
# granted deliberately — breadth here is intended, see
# docs/superpowers/specs/2026-08-30-self-evaluation-design.md.
#
# The same token backs BUILDER_PUSH_TOKEN below. Branch scoping for builder is
# enforced in code (pushBranch's regex), not by the token.
GITHUB_PR_TOKEN=

# Shared secret configured when setting up the repo's webhook (Settings →
# Webhooks → Add webhook). Used to verify incoming events are genuinely
# from GitHub, not forged.
GITHUB_WEBHOOK_SECRET=

# Port the webhook receiver listens on locally; the ngrok tunnel (or, in
# production, a reverse proxy) forwards GitHub's requests here.
WEBHOOK_PORT=8787

# Push-and-open-PR gate for the builder agent. Read at runtime by the
# pushBranch tool (src/runner/sdk-runner.ts) to build the push URL — the one
# grant kind whose secret is consulted beyond boot-time well-formedness
# checking.
#
# Set this to the SAME value as GITHUB_PR_TOKEN above. It is a separate
# variable because the two back different grants (builder-push vs infra-repo)
# and could diverge later, not because the credentials differ today.
BUILDER_PUSH_TOKEN=

# Products token ("clanker-products"): a fine-grained PAT whose resource owner
# is the products organization, with EVERY repository and organization
# permission granted, including Administration.
#
# Maximum permissions are safe here because a fine-grained token cannot reach
# outside its resource owner: this one is structurally incapable of touching
# Clanker-HQ's own repos, clanker-automated-system included. The confinement
# comes from the resource owner, not from withholding permissions — which is
# why a classic PAT is the wrong instrument for this slot, since its reach is
# account-wide and cannot be narrowed to one org.
#
# This is where the system builds revenue products with no restrictions at
# all. NOT YET USABLE: it needs a grants.yaml entry naming the org before any
# agent can push there, and grants.yaml is on EXCLUDED_PATHS so that edit is
# always a human one.
GITHUB_PRODUCTS_TOKEN=

# ---------------------------------------------------------------------------
# Chrome Web Store Publish API — NOT YET USABLE: no publishExtension tool or
# provision-kind grant exists yet to consult these. Documented here so the
# credential has a home once that lands (same shape as GITHUB_PRODUCTS_TOKEN
# above: read server-side by a future tool, never inherited into an agent's
# own Bash environment via CHILD_ENV_ALLOWLIST).
#
# All three come from the same Google Cloud OAuth client — see
# https://developer.chrome.com/docs/webstore/using-api for the full flow.
# CHROME_WEBSTORE_REFRESH_TOKEN is the long-lived credential; the other two
# are needed alongside it to mint short-lived access tokens.
CHROME_WEBSTORE_CLIENT_ID=
CHROME_WEBSTORE_CLIENT_SECRET=
CHROME_WEBSTORE_REFRESH_TOKEN=
# Developer Dashboard -> Publisher -> Settings. Required on every API call.
CHROME_WEBSTORE_PUBLISHER_ID=

# ---------------------------------------------------------------------------
# System mailbox — NOT YET READ BY ANY CODE.
#
# No mail capability is built yet; these are documented here so the credential
# has a home once it lands. See
# docs/superpowers/specs/2026-08-30-self-evaluation-design.md — an email
# identity is what lets the system register for services on its own instead of
# routing every signup through a human.
#
# The account is operator-owned. MAIL_APP_PASSWORD is a revocable app password
# (Gmail: Security -> App passwords, which only appears once 2-Step
# Verification is enabled), NEVER the real account password: an app password
# can send and receive mail and nothing else — it cannot sign in to the web
# UI, change the password, or alter recovery settings. Revoking it cuts the
# system's mail access instantly without touching the account.
#
# This must never be the recovery address for the spend account. Anything
# registered to a mailbox the system can read is effectively system-
# controlled.
MAIL_ADDRESS=
MAIL_APP_PASSWORD=

# Literal defaults for Gmail — copy as-is. For Zoho: imap.zoho.eu /
# smtp.zoho.eu. For Fastmail: imap.fastmail.com / smtp.fastmail.com.
# 993 is IMAP over TLS; 587 is SMTP with STARTTLS.
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587

# ---------------------------------------------------------------------------
# Spend pot — NOT YET READ BY ANY CODE.
#
# The prepaid account the system spends from. See
# docs/superpowers/specs/2026-08-30-self-evaluation-design.md — revenue is
# read separately, from the merchant-of-record via REVENUE_API_TOKEN below,
# not from this account (see READ SIDE note below for why).
#
# The account is operator-owned and KYC'd in the operator's name. The system
# never gets the account's password-reset inbox, and never gets the linked
# funding source. Auto-topup stays OFF: the balance is the ceiling, enforced
# by the bank rather than by anything in this repo.

# READ SIDE — leave EMPTY on Revolut personal (its API is business-only).
# This is not a gap: revenue is read from the payment processor, not the bank.
# A bank payout is a lump transfer with no line items, so it cannot attribute
# income to a product or a thread; the merchant-of-record's API can. The bank
# account is a spend instrument only, and its ceiling holds whether or not
# the system can read the balance. Set these only if the account provider
# actually offers a read token (e.g. Wise) and there is a reason to read it.
SPEND_API_TOKEN=
SPEND_API_BASE=

# Revenue instrument — the merchant of record (Lemon Squeezy / Gumroad /
# Stripe), set once there is something to sell. This is what the primary goal
# metric is computed from: per-sale records with product, timestamp, amount.
REVENUE_API_TOKEN=
REVENUE_API_BASE=

# Separate, narrower Stripe key for CREATING checkout objects (Products,
# Prices, Checkout Sessions) — deliberately not the same key as
# REVENUE_API_TOKEN above, which only ever needs read access (Balance/
# Charges) for the weekly revenue-metrics job. A Stripe *restricted* key
# (Dashboard -> Developers -> API keys -> Create restricted key), scoped to
# exactly: Products write, Prices write, Checkout Sessions write, nothing
# else. NOT YET USABLE: no tool exists yet to create a Stripe product/
# checkout flow with it.
STRIPE_CHECKOUT_TOKEN=

# SPEND SIDE — leave EMPTY for now.
# Nothing can use these yet: paying at a checkout needs browser capability,
# which is not built (README, "Not built yet"). A card PAN is also a weaker
# secret than a token — it cannot be scoped, it works anywhere card-not-
# present is accepted, and rotating it means reissuing the card. Fill these
# only once a consumer exists, and prefer a provider-side single-merchant or
# single-use lock over anything this repo could enforce.
SPEND_CARD_NUMBER=
SPEND_CARD_EXPIRY=
SPEND_CARD_CVC=

# Web dashboard — optional. Both must be set for it to start; leaving either
# empty means no dashboard server runs (matches REVENUE_API_TOKEN's posture).
# Basic Auth, so keep this on HTTPS in any real deployment (ngrok now, Caddy
# once/if a VPS exists) — credentials go out with every request.
DASHBOARD_PORT=8788
DASHBOARD_USER=
DASHBOARD_PASSWORD=

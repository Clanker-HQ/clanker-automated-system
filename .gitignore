# Secrets — NEVER commit. A leaked OAuth token is full access to your Claude account.
.env
.env.*
!.env.example

# Runtime data (docker volume): workspaces, transcripts, run records
data/

node_modules/
dist/
*.log

# Subagent-driven-development scratch (ledgers, briefs, review packages) — never a deliverable.
.superpowers/

# Isolated workspaces for plan execution.
.worktrees/

# Generated at boot from deploys.yaml (src/deploy/caddyfile.ts) into a
# read-write bind mount. Must stay gitignored — see Task 3 of
# docs/superpowers/plans/2026-09-01-deploy-path.md Step 6: a tracked copy
# would leave the VPS working tree dirty every boot, which wedges
# scripts/auto-deploy.sh's `git merge --ff-only`.
caddy/Caddyfile
caddy/deployments.tsv

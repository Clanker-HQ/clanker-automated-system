{
  "name": "claude-agent-infrastructure",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx scripts/supervise.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "schema": "tsx scripts/emit-schema.ts",
    "probe": "tsx scripts/probe-sdk.ts",
    "probe:canusetool": "tsx scripts/probe-canusetool.ts",
    "probe:e2e-approval": "tsx --env-file-if-exists=.env scripts/probe-e2e-approval.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "@anthropic-ai/claude-code": "^2.1.261",
    "croner": "^10.0.1",
    "discord.js": "^14.27.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
